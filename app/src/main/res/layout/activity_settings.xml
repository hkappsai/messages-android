<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            style="@style/SectionHeader"
            android:text="Default SMS app" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/default_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/default_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_default" />
        </LinearLayout>

        <TextView
            style="@style/SectionHeader"
            android:text="Theme" />

        <RadioGroup
            android:id="@+id/theme_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <RadioButton
                android:id="@+id/mode_system"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Follow system" />

            <RadioButton
                android:id="@+id/mode_light"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Light" />

            <RadioButton
                android:id="@+id/mode_dark"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Dark" />

            <RadioButton
                android:id="@+id/mode_black"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Black (saves battery on OLED screens)" />
        </RadioGroup>

        <TextView
            style="@style/SectionHeader"
            android:text="Accent color" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/accent_colors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>

        <TextView
            style="@style/SectionHeader"
            android:text="Sent bubble color" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/bubble_colors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp" />

        <TextView
            style="@style/SectionHeader"
            android:text="Notifications" />

        <TextView
            android:id="@+id/notification_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:text="Sound, vibration and pop-up settings"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp" />

        <TextView
            style="@style/SectionHeader"
            android:text="Blocked numbers" />

        <LinearLayout
            android:id="@+id/blocked_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
